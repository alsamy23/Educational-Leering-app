{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user progress and profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's authentication UID." },
        "name": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "subject": { "type": "string" },
        "focus": { "type": "string" },
        "topic": { "type": "string" },
        "level": { "type": "number" },
        "totalQuizzes": { "type": "number" },
        "totalPoints": { "type": "number" },
        "progressMap": { 
          "type": "object",
          "description": "Map of subject-grade to level"
        },
        "testHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": { "type": "string" },
              "score": { "type": "number" },
              "total": { "type": "number" },
              "date": { "type": "string", "format": "date-time" },
              "type": { "type": "string", "enum": ["individual", "classroom"] },
              "subject": { "type": "string" }
            }
          }
        }
      },
      "required": ["uid", "name", "gradeLevel", "totalPoints", "level"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and progress data."
    }
  }
}
